NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/stackroast
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# Expired posts and their comments are permanently removed after this many days.
EXPIRED_RETENTION_DAYS=30
# Comma-separated email addresses allowed to receive the admin role at registration.
# Add your own email BEFORE registering your admin account.
ADMIN_EMAILS=admin@example.com
