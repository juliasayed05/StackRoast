# Copy the server values to server/.env
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/stackroast
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
EXPIRED_RETENTION_DAYS=30

# Copy this value to client/.env
VITE_API_URL=http://localhost:5000/api
